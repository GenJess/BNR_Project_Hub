<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --navy:#0e1b2e;--navy-mid:#162236;--navy-light:#1e3048;
  --gold:#b8862a;--gold-light:#d4a445;--gold-pale:#f5edd8;
  --cream:#f8f4ee;--cream-mid:#f0e9de;--cream-deep:#e6dccf;
  --text-dark:#0e1b2e;--text-mid:#3a4a5c;--text-muted:#6b7a8d;
  --divider:rgba(14,27,46,0.1);
  --shadow-sm:0 2px 8px rgba(14,27,46,0.06);
  --shadow-md:0 8px 24px rgba(14,27,46,0.08);
  --shadow-lg:0 20px 48px rgba(14,27,46,0.12);
  --r:6px;--r-lg:12px;
  --teal:#2a7a8b;--green:#3d7a4a;--red:#9a3030;
}
html{scroll-behavior:smooth}
body{font-family:'IBM Plex Sans',system-ui,sans-serif;color:var(--text-dark);background:var(--cream);line-height:1.65;font-size:15px;overflow-x:hidden}

/* === HEADER === */
header{position:sticky;top:0;z-index:100;background:var(--navy);border-bottom:2px solid var(--gold);height:64px;display:flex;align-items:center}
.header-inner{max-width:1100px;margin:0 auto;width:100%;padding:0 2rem;display:flex;align-items:center;justify-content:space-between}
.logo{display:flex;align-items:center;gap:10px;text-decoration:none}
.logo-mark{width:36px;height:36px;background:var(--gold);border-radius:6px;display:flex;align-items:center;justify-content:center;font-family:'Playfair Display',serif;font-weight:700;font-size:14px;color:var(--navy);letter-spacing:0.5px}
.logo-text{font-family:'IBM Plex Sans',sans-serif;font-weight:500;font-size:14px;color:var(--cream);letter-spacing:0.3px}
.nav-links{display:flex;gap:8px}
.nav-links a{font-family:'IBM Plex Mono',monospace;font-size:11px;text-transform:uppercase;letter-spacing:0.15em;color:var(--cream-mid);text-decoration:none;padding:6px 12px;border-radius:var(--r);transition:all .2s}
.nav-links a:hover,.nav-links a.active{color:var(--gold-light);background:rgba(184,134,42,0.1)}

/* === HERO === */
.hero{background:var(--navy);padding:64px 2rem 56px;position:relative;overflow:hidden}
.hero::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse at 30% 80%,rgba(184,134,42,0.08) 0%,transparent 70%)}
.hero-inner{max-width:1100px;margin:0 auto;position:relative;z-index:1}
.hero h1{font-family:'Playfair Display',serif;font-size:clamp(28px,4vw,42px);font-weight:700;color:var(--cream);line-height:1.2;margin-bottom:12px}
.hero .subtitle{font-size:17px;color:var(--cream-mid);font-weight:300;max-width:700px;line-height:1.6}
.hero .subtitle strong{color:var(--gold-light);font-weight:500}

/* === DOC NAV === */
.doc-nav{background:var(--navy-mid);border-bottom:1px solid rgba(255,255,255,0.06);padding:0 2rem}
.doc-nav-inner{max-width:1100px;margin:0 auto;display:flex;gap:0;overflow-x:auto}
.doc-nav a{font-family:'IBM Plex Mono',monospace;font-size:11px;text-transform:uppercase;letter-spacing:0.15em;color:var(--cream-deep);text-decoration:none;padding:14px 20px;border-bottom:2px solid transparent;transition:all .2s;white-space:nowrap}
.doc-nav a:hover{color:var(--gold-light);border-bottom-color:var(--gold)}
.doc-nav a.active{color:var(--gold-light);border-bottom-color:var(--gold)}

/* === MAIN === */
main{max-width:1100px;margin:0 auto;padding:48px 2rem 96px}

/* === SECTION LABELS === */
.section-label{font-family:'IBM Plex Mono',monospace;font-size:10px;text-transform:uppercase;letter-spacing:0.2em;color:var(--gold);margin-bottom:20px;display:flex;align-items:center;gap:12px}
.section-label::after{content:'';flex:1;height:1px;background:var(--divider)}

/* === DOC SECTIONS === */
.doc-section{margin-bottom:64px;scroll-margin-top:80px}
.doc-section h2{font-family:'Playfair Display',serif;font-size:clamp(24px,3vw,32px);font-weight:700;color:var(--text-dark);margin-bottom:8px;line-height:1.25}
.doc-section .doc-date{font-family:'IBM Plex Mono',monospace;font-size:12px;color:var(--text-muted);margin-bottom:24px}
.doc-section h3{font-family:'Playfair Display',serif;font-size:20px;font-weight:600;color:var(--text-dark);margin:32px 0 12px;line-height:1.3}
.doc-section h4{font-family:'IBM Plex Sans',sans-serif;font-size:15px;font-weight:600;color:var(--text-dark);margin:24px 0 8px}
.doc-section p{color:var(--text-mid);margin-bottom:14px;max-width:760px}
.doc-section ul,.doc-section ol{color:var(--text-mid);margin:0 0 16px 20px}
.doc-section li{margin-bottom:6px}
.doc-section li strong{color:var(--text-dark)}

/* === EXECUTIVE CARD === */
.exec-card{background:var(--navy);border-radius:var(--r-lg);padding:32px 36px;margin:24px 0 32px;color:var(--cream)}
.exec-card h3{color:var(--gold-light);margin:0 0 16px;font-size:18px}
.exec-card p{color:var(--cream-mid);max-width:none}
.exec-card .big-number{font-family:'Playfair Display',serif;font-size:clamp(32px,5vw,48px);font-weight:700;color:var(--gold-light);margin:8px 0 4px}
.exec-card .big-label{font-family:'IBM Plex Mono',monospace;font-size:11px;text-transform:uppercase;letter-spacing:0.15em;color:var(--cream-deep)}

/* === TABLES === */
.data-table{width:100%;border-collapse:collapse;margin:20px 0 28px;font-size:14px;background:#fff;border-radius:var(--r-lg);overflow:hidden;box-shadow:var(--shadow-sm)}
.data-table thead{background:var(--navy)}
.data-table th{font-family:'IBM Plex Mono',monospace;font-size:11px;text-transform:uppercase;letter-spacing:0.1em;color:var(--cream-mid);padding:12px 16px;text-align:left;font-weight:500}
.data-table td{padding:12px 16px;border-bottom:1px solid var(--divider);color:var(--text-mid);vertical-align:top}
.data-table tr:last-child td{border-bottom:none}
.data-table .highlight-row{background:var(--gold-pale)}
.data-table .source-link{font-family:'IBM Plex Mono',monospace;font-size:11px;color:var(--gold);text-decoration:none}
.data-table .source-link:hover{text-decoration:underline}
.data-table .money{font-family:'IBM Plex Mono',monospace;font-weight:500;color:var(--text-dark)}

/* === STAT GRID === */
.stat-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:16px;margin:24px 0 32px}
.stat-card{background:#fff;border-radius:var(--r-lg);padding:24px;box-shadow:var(--shadow-sm);border-top:3px solid var(--gold)}
.stat-card .stat-value{font-family:'Playfair Display',serif;font-size:28px;font-weight:700;color:var(--navy);margin-bottom:4px}
.stat-card .stat-label{font-family:'IBM Plex Mono',monospace;font-size:10px;text-transform:uppercase;letter-spacing:0.15em;color:var(--text-muted)}

/* === TIMELINE === */
.timeline{position:relative;margin:24px 0 32px;padding-left:28px}
.timeline::before{content:'';position:absolute;left:8px;top:4px;bottom:4px;width:2px;background:linear-gradient(to bottom,var(--gold),var(--navy))}
.timeline-item{position:relative;margin-bottom:28px}
.timeline-item::before{content:'';position:absolute;left:-24px;top:6px;width:12px;height:12px;border-radius:50%;background:var(--gold);border:2px solid var(--cream)}
.timeline-item.shipped::before{background:var(--green)}
.timeline-item.blocked::before{background:var(--red)}
.timeline-item .tl-date{font-family:'IBM Plex Mono',monospace;font-size:11px;text-transform:uppercase;letter-spacing:0.1em;color:var(--gold);margin-bottom:4px}
.timeline-item .tl-title{font-family:'Playfair Display',serif;font-size:17px;font-weight:600;color:var(--text-dark);margin-bottom:6px}
.timeline-item .tl-body{color:var(--text-mid);font-size:14px;line-height:1.6}
.timeline-item .tl-body ul{margin:6px 0 0 16px}
.timeline-item .tl-body li{margin-bottom:3px}
.timeline-item .tl-tag{display:inline-block;font-family:'IBM Plex Mono',monospace;font-size:10px;text-transform:uppercase;letter-spacing:0.1em;padding:3px 8px;border-radius:4px;margin-right:6px;margin-top:8px}
.tl-tag.shipped{background:rgba(61,122,74,0.1);color:var(--green)}
.tl-tag.milestone{background:rgba(184,134,42,0.12);color:var(--gold)}
.tl-tag.decision{background:rgba(42,122,139,0.1);color:var(--teal)}

/* === CALLOUT === */
.callout{border-left:3px solid var(--gold);background:rgba(184,134,42,0.06);padding:16px 20px;border-radius:0 var(--r) var(--r) 0;margin:20px 0 24px}
.callout p{margin:0;color:var(--text-mid)}
.callout strong{color:var(--text-dark)}
.callout.navy{border-left-color:var(--navy);background:rgba(14,27,46,0.04)}
.callout.teal{border-left-color:var(--teal);background:rgba(42,122,139,0.05)}

/* === DIVIDER === */
.section-divider{border:none;height:1px;background:var(--divider);margin:64px 0}

/* === FOOTER === */
footer{background:var(--navy);padding:32px 2rem;border-top:2px solid var(--gold)}
.footer-inner{max-width:1100px;margin:0 auto;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px}
.footer-brand{font-family:'IBM Plex Mono',monospace;font-size:11px;color:var(--cream-deep);letter-spacing:0.05em}
.footer-meta{font-family:'IBM Plex Mono',monospace;font-size:11px;color:var(--text-muted)}

/* === RESPONSIVE === */
@media(max-width:600px){
  .header-inner{padding:0 1rem}
  .hero{padding:40px 1rem 36px}
  .doc-nav{padding:0 1rem}
  .doc-nav a{padding:12px 14px;font-size:10px}
  main{padding:32px 1rem 64px}
  .exec-card{padding:24px 20px}
  .stat-grid{grid-template-columns:1fr 1fr}
  .data-table{font-size:13px}
  .data-table th,.data-table td{padding:10px 12px}
  .footer-inner{flex-direction:column;text-align:center}
  .nav-links{display:none}
}
</style>
</head>
